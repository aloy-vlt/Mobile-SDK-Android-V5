<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF1A1A1A"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dashboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LAN Dashboard Server"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_dashboard_help"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFBBBBBB"
        android:textSize="13sp"
        android:text="Streams the main camera (MJPEG-over-WebSocket) + telemetry to any browser on the same Wi-Fi. Connect the drone first, then start the server."
        app:layout_constraintTop_toBottomOf="@id/tv_dashboard_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_dashboard_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Start Server"
        app:layout_constraintTop_toBottomOf="@id/tv_dashboard_help"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_dashboard_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FF00FF00"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:text="Stopped"
        app:layout_constraintTop_toBottomOf="@id/btn_dashboard_toggle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_dashboard_url"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FFFFFF00"
        android:textSize="16sp"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        app:layout_constraintTop_toBottomOf="@id/tv_dashboard_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_dashboard_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#FFBBBBBB"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:text="Clients: 0   |   FPS: 0"
        app:layout_constraintTop_toBottomOf="@id/tv_dashboard_url"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
