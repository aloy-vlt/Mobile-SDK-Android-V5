<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A1A">

    <!-- ═══ TOP: Settings ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="#FF222222">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Levels:"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_levels"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:text="4"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:inputType="number"
                android:gravity="center"
                android:background="#FF444444"
                android:padding="2dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tv_config_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="P:0.12 D:0.08 | Sweep:20 Climb:53 | Hgt:0.5m"
                android:textColor="#FFAAAAAA"
                android:textSize="8sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- OA mode row: 3 modes mapped to PerceptionManager.setObstacleAvoidanceType.
             BRAKE = stop on obstacle (full OA), BYPASS = fly around (APAS),
             OFF = OA disabled. OFF is the sane default for a rack-scan where the
             drone is intentionally flying close to the rack. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OA:"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_oa_brake"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="BRAKE"
                android:textSize="9sp"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/btn_oa_bypass"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="BYPASS"
                android:textSize="9sp"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/btn_oa_close"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:text="OFF"
                android:textSize="9sp"
                android:layout_margin="2dp" />
        </LinearLayout>

        <!-- P / D sliders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="P"
                android:textColor="#FF88CC88"
                android:textSize="10sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seek_pgain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="27"
                android:progress="9" />

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="D"
                android:textColor="#FF88AACC"
                android:textSize="10sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seek_dgain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:progress="8" />
        </LinearLayout>

        <!-- Speed / Height sliders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="Spd"
                android:textColor="#FFCCAA88"
                android:textSize="9sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seek_sweep_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="6"
                android:progress="1" />

            <View android:layout_width="8dp" android:layout_height="1dp" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="Clb"
                android:textColor="#FFCC88CC"
                android:textSize="9sp"
                android:gravity="center" />

            <SeekBar
                android:id="@+id/seek_climb_speed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="6"
                android:progress="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ MIDDLE: Camera + Status ═══ -->

    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:background="#FF000000" />

    <!-- State -->
    <TextView
        android:id="@+id/tv_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IDLE - Set levels and Start Scan"
        android:textColor="#FF00FF00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:background="#EE000000"
        android:maxLines="2" />

    <!-- Marker info -->
    <TextView
        android:id="@+id/tv_marker_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Target: -- | Waiting"
        android:textColor="#FFFFFF00"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:padding="2dp" />

    <!-- Stick debug (shows actual values being sent) -->
    <TextView
        android:id="@+id/tv_stick_debug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stick → Roll:0 Thr:0"
        android:textColor="#FF00CCFF"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:padding="2dp" />

    <!-- Safety warning -->
    <TextView
        android:id="@+id/tv_safety"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFFF4444"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:padding="4dp"
        android:background="#44FF0000"
        android:visibility="gone" />

    <!-- ═══ BOTTOM: Buttons ═══ -->

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#FF555555"
        android:layout_marginTop="4dp" />

    <!-- Flight buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="3dp"
        android:background="#FF2A2A2A">

        <Button
            android:id="@+id/btn_takeoff"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="TAKE OFF"
            android:textSize="9sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_enable_vs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="ENABLE VS"
            android:textSize="9sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_start_scan"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="START SCAN"
            android:textSize="9sp"
            android:layout_margin="2dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_land"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="LAND"
            android:textSize="9sp"
            android:layout_margin="2dp" />
    </LinearLayout>

    <!-- 16dp spacer between flight and action buttons -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="#FF2A2A2A" />

    <!-- Action buttons — single row: LEFT / UP / DOWN / RIGHT / STOP.
         Equal weights, compact padding/text so nothing is occluded. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="6dp"
        android:background="#FF2A2A2A">

        <Button
            android:id="@+id/btn_go_left"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="◄ L"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:backgroundTint="#FF2E7D32" />

        <Button
            android:id="@+id/btn_go_up"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="▲ UP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:backgroundTint="#FF1565C0" />

        <Button
            android:id="@+id/btn_go_down"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="▼ DN"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:backgroundTint="#FF1565C0" />

        <Button
            android:id="@+id/btn_go_right"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="R ►"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:backgroundTint="#FF2E7D32" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="■ STOP"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:layout_margin="2dp"
            android:visibility="gone"
            android:backgroundTint="#FFC62828" />
    </LinearLayout>

</LinearLayout>
