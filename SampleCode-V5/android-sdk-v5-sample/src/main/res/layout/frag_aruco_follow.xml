<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A1A"
    android:padding="8dp">

    <!-- Camera preview -->
    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:background="#FF000000" />

    <!-- Status area -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready - Take off first"
        android:textColor="#FF00FF00"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:padding="4dp"
        android:background="#CC000000" />

    <TextView
        android:id="@+id/tv_offset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No marker"
        android:textColor="#FFFFFF00"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="4dp" />

    <!-- P-Gain slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/tv_gain"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="P-Gain: 0.15"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <SeekBar
            android:id="@+id/seek_gain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="45"
            android:progress="10" />
    </LinearLayout>

    <!-- D-Gain slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/tv_dgain"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:text="D-Gain: 0.10"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <SeekBar
            android:id="@+id/seek_dgain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="30"
            android:progress="10" />
    </LinearLayout>

    <!-- Control buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_takeoff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Take Off"
            android:textSize="10sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_enable_vs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable VS"
            android:textSize="10sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_start_track"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start Tracking"
            android:textSize="10sp"
            android:layout_margin="2dp" />

        <Button
            android:id="@+id/btn_land"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Land"
            android:textSize="10sp"
            android:layout_margin="2dp" />
    </LinearLayout>

</LinearLayout>
